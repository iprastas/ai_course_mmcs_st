OPENAI_API_KEY=your-aitunnel-key-here
OPENAI_BASE_URL=https://api.aitunnel.ru/v1
MODEL=mimo-v2.6-flash

# веб-приложение (week2/app): учётки живут в SQLite (data/auth.sqlite) в виде
# PBKDF2-хэшей — регистрация прямо на сайте. APP_USERS ниже — лишь стартовый
# «бутстрап»: пары логин:пароль при первом входе один раз зашиваются в базу
# хэшем, дальше .env можно не хранить пароли вовсе (оставьте пустым).
APP_USERS=admin:admin,guest:guest
# демо-вход одной кнопкой на экране логина (DEMO_USER должен существовать —
# из APP_USERS или после регистрации; пусто — кнопка отвечает 404)
DEMO_USER=
DEMO_PASSWORD=
# эмбеддинги для семантического поиска (строка в /v1/embeddings)
EMBED_MODEL=text-embedding-3-small
# ₽ за миллион токенов (вход/выход)
PRICE_IN=30
PRICE_OUT=120
